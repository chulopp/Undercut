# ==============================================================================
# UNDERCUT - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` or `.env` and fill in the values.
# Do NOT commit your actual keys/secrets to git!

# ------------------------------------------------------------------------------
# 1. Next.js App Configuration
# ------------------------------------------------------------------------------
# The public URL of the application. Used for Supabase Auth redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Direct or pooled connection string from Neon Console
DATABASE_URL=postgresql://user:password@ep-project-id.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2.1 NextAuth.js v5 (Auth.js) & Google OAuth
# ------------------------------------------------------------------------------
AUTH_SECRET=your-random-32-byte-base64-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-your-google-client-secret

# ------------------------------------------------------------------------------
# 3. LLM API Keys & Provider Settings
# ------------------------------------------------------------------------------
# API Key for OpenRouter (used for Gate 1 and Gate 2 Fallbacks)
OPENROUTER_API_KEY=sk-or-v1-...

# API Key for DeepSeek (used directly for Gate 2 main model)
DEEPSEEK_API_KEY=sk-...

# ------------------------------------------------------------------------------
# 4. LLM Models Configuration
# ------------------------------------------------------------------------------
# Gate 1: Relevance & Sentiment Classifier (OpenRouter)
GATE1_MODEL_PRIMARY=nvidia/nemotron-3-super-120b-a12b:free
GATE1_MODEL_FALLBACK=google/gemma-4-31b-it:free,poolside/laguna-m.1:free,poolside/laguna-xs-2.1:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-content-safety:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-nano-12b-v2-vl:free,openai/gpt-oss-20b:free,cognitivecomputations/dolphin-mistral-24b-venice-edition:free,meta-llama/llama-3.2-3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free

# Gate 2: Contextual Reply Generator (DeepSeek Direct / OpenRouter Fallback)
GATE2_MODEL=deepseek-chat
GATE2_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-120b:free,qwen/qwen3-coder:free,nousresearch/hermes-3-llama-3.1-405b:free,poolside/laguna-xs-2.1:free,cohere/north-mini-code:free,nvidia/nemotron-3-nano-30b-a3b:free,openai/gpt-oss-20b:free,meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# 5. Scraper Integration (RapidAPI)
# ------------------------------------------------------------------------------
# API Key for RapidAPI integrations
RAPIDAPI_KEY=your-rapidapi-key-here

# RapidAPI hosts for social media scraping
RAPIDAPI_HOST_TWITTER=twitter-api45.p.rapidapi.com
RAPIDAPI_HOST_INSTAGRAM=instagram-scraper-stable-api.p.rapidapi.com

# Mock Settings: Set to true during development/demo to avoid RapidAPI usage and costs
USE_MOCK_SCRAPER=false

# ------------------------------------------------------------------------------
# 6. Payment Gateway Settings (Midtrans & Stripe)
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_IS_PRODUCTION=false

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...


# ------------------------------------------------------------------------------
# 7. Business & Billing Configuration
# ------------------------------------------------------------------------------
# Fixed exchange rate conversion (1 USD = IDR Rate)
USD_TO_IDR_RATE=16000

# Top-up Bonus Tiers
TOPUP_BONUS_TIER_1_THRESHOLD=50
TOPUP_BONUS_TIER_1_PERCENT=3
TOPUP_BONUS_TIER_2_THRESHOLD=100
TOPUP_BONUS_TIER_2_PERCENT=5
